# Copie para .env e preencha. NUNCA commite o .env.

# Chave da GeckoAPI (https://dashboard.geckoapi.com.br)
GECKOAPI_KEY=cole_sua_chave_aqui

# Webhook do canal do Discord (Editar canal > Integracoes > Webhooks > Novo webhook)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000/xxxxxxxx

# --- Opcionais (os valores abaixo sao os padroes) ---

# Rota e datas monitoradas
ORIGIN=BEL
DESTINATION=NAT
DEPARTURE_DATE=2026-12-27
RETURN_DATE=2027-01-05
NUM_ADULTS=1
NUM_CHILDREN=0
NUM_INFANTS=0
CURRENCY=BRL

# Orcamento de creditos
MONTHLY_CREDIT_BUDGET=100
CREDITS_PER_REQUEST=5

# --- Janelas de execucao ---
TIMEZONE=America/Belem
# Checagem regular, a cada CHECK_INTERVAL_DAYS dias.
MORNING_WINDOW=05:00-09:00
# Janela extra, usada SO na vespera do reset de creditos, para gastar o saldo
# que sobrou antes de expirar. EVENING_BURST_ENABLED=false desliga.
EVENING_WINDOW=20:00-23:00
EVENING_BURST_ENABLED=true
# A GeckoAPI NAO informa quando os creditos resetam (/v1/me/credits traz so
# saldo e consumo), entao assumimos um dia fixo do mes. O bot registra cada
# saldo observado e `status` mostra em que dia o reset realmente aconteceu.
CREDIT_RESET_DAY=1

# Intervalo do scheduler, em dias.
# Uma checagem = 1 request ao KAYAK = 5 creditos (antes eram 10, com LATAM+Azul
# separados). 2 dias = no maximo 16 checagens/mes = 80 creditos.
CHECK_INTERVAL_DAYS=2

# --- Banco ---
# Deixe TURSO_DATABASE_URL vazio para usar SQLite local (desenvolvimento).
# Preenchido, o bot vai para o Turso e ignora o DB_PATH — e o que permite rodar
# no GitHub Actions, onde o disco e descartado no fim de cada execucao.
# Pegue os dois com: turso db show voos --url  /  turso db tokens create voos
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# So usado quando TURSO_DATABASE_URL esta vazio.
# Evite deixar dentro de pasta sincronizada (OneDrive/Dropbox): o modo WAL do
# SQLite cria arquivos irmaos que o sync corrompe.
DB_PATH=data/prices.db
HTTP_TIMEOUT_SECONDS=120

# Cada tentativa HTTP custa 5 creditos, entao retry aqui e decisao de custo.
# 1 retry = no maximo 10 creditos por companhia.
HTTP_MAX_RETRIES=1
# Pausa antes de repetir. A GeckoAPI raspa o site da companhia; repetir no
# segundo seguinte a um UPSTREAM_TIMEOUT encontra a mesma lentidao.
HTTP_RETRY_DELAY_SECONDS=60
# Teto de creditos de UMA execucao, independente do saldo do mes. Impede que
# uma sequencia de erros 5xx consuma varias checagens de uma vez.
MAX_CREDITS_PER_RUN=10
LOG_LEVEL=INFO
